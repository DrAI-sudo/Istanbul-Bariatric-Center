    <script>
      (function() {
        var chatLoaded = false;
        function loadChat() {
          if (chatLoaded) return;
          chatLoaded = true;
          var s = document.createElement('script');
          s.src = 'https://web.archive.org/web/20251227060329/https://www.chat-data.com/embed.min.js?chatbotId=67ccb5256b01cddd3d5cbaa7';
